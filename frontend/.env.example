# Copy to .env and fill in. Everything here is bundled into the app, so put
# only publishable values in it — never a service-role key or a JWT secret.

# Where the backend lives. Leave unset for emulators/simulators: the client
# already picks 10.0.2.2 on Android and localhost on iOS. Set it to the host
# machine's LAN address when running on a physical device.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Supabase project, used for anonymous sign-in. Without these the app still
# runs — Scan and Tone need no auth — but Dashboard and Practice will say
# they're unavailable rather than failing with a 401.
# The anon key is designed to ship in clients; row-level security is what
# protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
