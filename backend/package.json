{
  "name": "echobreaker-backend",
  "version": "0.1.0",
  "description": "Backend for the echo-chamber-breaking app (Scan & Context, Tone Check, Dashboard, Practice)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/localServer.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/localServer.js",
    "seed": "tsx -r tsconfig-paths/register src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx -r tsconfig-paths/register src/db/migrate.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.9.6",
    "node-fetch": "^3.3.2",
    "pg": "^8.12.0",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
