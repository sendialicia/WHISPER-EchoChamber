{
  "name": "echobreaker-backend",
  "version": "0.1.0",
  "description": "Backend for the echo-chamber-breaking app (Scan & Context, Tone Check, Dashboard, Practice)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx -r tsconfig-paths/register src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "cheerio": "^1.0.0",
    "node-fetch": "^3.3.2",
    "tsconfig-paths": "^4.2.0",
    "better-sqlite3": "^11.3.0",
    "pg": "^8.12.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.15",
    "@types/better-sqlite3": "^7.6.11",
    "@types/pg": "^8.11.6"
  }
}