# Copy to .env and fill in. Also the list of variables to set on whatever
# host this is deployed to.

PORT=3000
NODE_ENV=development

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Triage and tone check — high volume, needs to be quick and cheap.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Full analysis and steelmanning — needs the stronger reasoning.
GEMINI_DEEP_MODEL=gemini-3.6-flash

# Comma-separated, tried in order once the primary keeps answering 503.
# Newest first, oldest last: a spike hits one model at a time, and the newest
# models are the most contended, so an older one is usually answering normally
# while the newest refuses everyone. Depth here is what keeps a demo alive.
GEMINI_FAST_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_DEEP_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash

# Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=

# Supabase → Project Settings → API → Project URL. Used to fetch the JWKS
# that verifies session tokens; every authed route 500s without it.
SUPABASE_URL=

# Unused while auth goes through Supabase's JWKS. Left here because env.ts
# still reads it.
JWT_SECRET=change_me
