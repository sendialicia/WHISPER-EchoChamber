# Copy to .env and fill in. Also the list of variables to set on whatever
# host this is deployed to.

PORT=3000
NODE_ENV=development

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Triage and tone check — high volume, needs to be quick and cheap.
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# Full analysis and steelmanning — needs the stronger reasoning.
GEMINI_DEEP_MODEL=gemini-2.5-flash

# Tried once when the primary keeps answering 503. Keep these on a different
# model from the ones above: demand spikes hit one model at a time, so
# pointing a fallback at its own primary just repeats the same failure.
GEMINI_FAST_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_DEEP_FALLBACK_MODEL=gemini-2.5-flash

# Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=

# Supabase → Project Settings → API → Project URL. Used to fetch the JWKS
# that verifies session tokens; every authed route 500s without it.
SUPABASE_URL=

# Unused while auth goes through Supabase's JWKS. Left here because env.ts
# still reads it.
JWT_SECRET=change_me
